          python-version: '3.11'

      - name: Instalar dependências
        run: pip install -r requirements.txt

      - name: Executar Análise IA e Notificar WhatsApp
        env:
          WHATSAPP_PHONE: \${{ secrets.WHATSAPP_PHONE }}
          CALLMEBOT_APIKEY: \${{ secrets.CALLMEBOT_APIKEY }}
        run: python bot_whatsapp_24h.py
`;
    }

    function renderCloudScripts() {
      const pyEl = document.getElementById('pythonCodePreview');
      const ymlEl = document.getElementById('ymlCodePreview');
      if (pyEl) pyEl.textContent = generatePythonBotCode();
      if (ymlEl) ymlEl.textContent = generateWorkflowYML();
    }

    function downloadFile(filename, content, mimeType = 'text/plain;charset=utf-8') {
      const blob = new Blob([content], { type: mimeType });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast(`Arquivo "${filename}" baixado!`, 'success');
    }

    function downloadPythonBot() {
      downloadFile('bot_whatsapp_24h.py', generatePythonBotCode(), 'text/x-python;charset=utf-8');
    }

    function downloadWorkflowYML() {
      downloadFile('crypto_bot.yml', generateWorkflowYML(), 'text/yaml;charset=utf-8');
    }

    function downloadRequirementsTxt() {
      downloadFile('requirements.txt', 'requests==2.32.3\n', 'text/plain;charset=utf-8');
    }

    function downloadWebAppHTML() {
      const htmlContent = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
      downloadFile('index.html', htmlContent, 'text/html;charset=utf-8');
    }

    function copyCodeBlock(elementId) {
      const el = document.getElementById(elementId);
      if (!el) return;
      const textarea = document.createElement('textarea');
      textarea.value = el.textContent;
      document.body.appendChild(textarea);
      textarea.select();
      try {
        document.execCommand('copy');
        showToast('Código copiado para a área de transferência!', 'success');
      } catch (e) {
        showToast('Não foi possível copiar automaticamente.', 'warning');
      }
      document.body.removeChild(textarea);
    }

    // =========================================================================
    // 9. NAVEGAÇÃO DE ABAS, TOASTS E TEMPORIZADOR
    // =========================================================================
    function switchTab(tabName) {
      ['dashboard', 'brain', 'alerts', 'cloud'].forEach(t => {
        document.getElementById(`view-${t}`).classList.add('hidden');
        const btn = document.getElementById(`tab-${t}`);
        btn.className = 'tab-btn px-4 py-2.5 text-xs sm:text-sm font-semibold border-b-2 border-transparent text-slate-400 hover:text-slate-200 whitespace-nowrap transition cursor-pointer';
      });

      document.getElementById(`view-${tabName}`).classList.remove('hidden');
      const activeBtn = document.getElementById(`tab-${tabName}`);
      activeBtn.className = 'tab-btn px-4 py-2.5 text-xs sm:text-sm font-semibold border-b-2 border-emerald-400 text-emerald-400 whitespace-nowrap transition cursor-pointer';
    }

    function showToast(message, type = 'info') {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      const colors = {
        success: 'bg-slate-900 border-emerald-500/50 text-emerald-300',
        warning: 'bg-slate-900 border-amber-500/50 text-amber-300',
        info: 'bg-slate-900 border-cyan-500/50 text-cyan-300'
      };
      toast.className = `pointer-events-auto border ${colors[type] || colors.info} rounded-xl px-4 py-3 text-xs font-semibold shadow-xl transition-all duration-300`;
      toast.textContent = message;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 300);
      }, 3200);
    }

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
    }

    function startCountdownLoop() {
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        countdown--;
        if (countdown <= 0) {
          countdown = 30;
          fetchMarketData(false);
        }
        const el = document.getElementById('countdownTimer');
        if (el) el.textContent = `${countdown}s`;
      }, 1000);
    }

    window.onload = function () {
      loadStateFromStorage();
      renderAlertHistory();
      fetchMarketData(false);
      startCountdownLoop();
    };
  </script>
</body>
