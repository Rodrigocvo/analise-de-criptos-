        badge.textContent = 'Neutro';
        badge.className = 'px-2 py-0.5 rounded-md bg-cyan-500/20 text-cyan-300 font-semibold';
      } else {
        badge.textContent = 'Ganância';
        badge.className = 'px-2 py-0.5 rounded-md bg-emerald-500/20 text-emerald-300 font-semibold';
      }
    }

