    function buildFallbackCoin(cfg, prev) {
      const jitter = prev ? (1 + (Math.random() - 0.5) * 0.004) : 1;
      const basePrice = prev ? prev.price * jitter : cfg.fallbackPrice;
      // Gera sparkline sintético coerente com a tendência de 7 dias
      const spark = [];
      let p = basePrice / (1 + cfg.fallback7d / 100);
      for (let i = 0; i < 42; i++) {
        p = p * (1 + (cfg.fallback7d / 100) / 42 + (Math.random() - 0.5) * 0.012);
        spark.push(p);
      }
      spark[spark.length - 1] = basePrice;

      return {
        ...cfg,
        price: basePrice,
        change1h: (cfg.fallback24h / 12) + (Math.random() - 0.5) * 0.4,
        change24h: cfg.fallback24h + (Math.random() - 0.5) * 0.3,
        change7d: cfg.fallback7d,
        high24h: Math.max(cfg.high24h, basePrice),
        low24h: Math.min(cfg.low24h, basePrice),
        volume24h: 1250000000,
        sparkline: spark,
        isFallback: true
      };
    }

    // =========================================================================
    // 4. MOTOR QUANTITATIVO & CÁLCULO DE POSIÇÃO FRACIONADA
    // =========================================================================
    function calculateRSI(prices, period = 14) {
      if (!prices || prices.length < period + 1) return null;
      let gains = 0;
      let losses = 0;
      const slice = prices.slice(-(period + 1));
      for (let i = 1; i < slice.length; i++) {
        const diff = slice[i] - slice[i - 1];
        if (diff >= 0) gains += diff;
        else losses -= diff;
      }
      const avgGain = gains / period;
      const avgLoss = losses / period;
      if (avgLoss === 0) return 100;
      const rs = avgGain / avgLoss;
      return 100 - (100 / (1 + rs));
    }

    function analyzeCoinQuantitatively(coin) {
      // 1. Calcula RSI 14 a partir do sparkline horário ou estima pelo momentum
      let rsi = calculateRSI(coin.sparkline, 14);
      if (rsi === null || isNaN(rsi)) {
        rsi = 50 + (coin.change24h * 2.1) + (coin.change7d * 0.65);
        rsi = Math.max(12, Math.min(89, rsi));
      }

      // 2. Posição no range de 24h (0% = mínima, 100% = máxima)
      const range = coin.high24h - coin.low24h;
      const rangePos = range > 0 ? ((coin.price - coin.low24h) / range) * 100 : 50;

      // 3. Média móvel simples dos últimos pontos do sparkline
      const sma = coin.sparkline && coin.sparkline.length > 0
        ? coin.sparkline.reduce((a, b) => a + b, 0) / coin.sparkline.length
        : coin.price;
      const distFromSmaPct = ((coin.price - sma) / sma) * 100;

      // Ajusta sensibilidade pelo perfil de risco do usuário
      let buyRsi = userSettings.rsiBuyThreshold;
      let sellRsi = userSettings.rsiSellThreshold;
      let dropTrigger = -4.5;
      let pumpTrigger = 4.2;

      if (userSettings.profile === 'conservative') {
        buyRsi -= 5;
        sellRsi += 5;
        dropTrigger = -6.5;
        pumpTrigger = 6.0;
      } else if (userSettings.profile === 'aggressive') {
        buyRsi += 5;
        sellRsi -= 5;
        dropTrigger = -3.0;
        pumpTrigger = 2.8;
      }

      // Score composto (-100 = sobrevenda extrema / compra forte; +100 = sobrecompra / realização)
      let score = 0;
      score += (rsi - 50) * 1.35;
      score += coin.change24h * 3.2;
      score += distFromSmaPct * 1.8;

      // Saldo do usuário nesta moeda
      const holding = userPortfolio[coin.id] || { usd: 0, qty: 0 };
      const effectiveUsd = holding.usd > 0 ? holding.usd : (holding.qty > 0 ? holding.qty * coin.price : 0);

      let action = 'WAIT'; // BUY | SELL | WAIT
      let actionLabel = 'ESPERAR / MANTER';
      let suggestedPct = 0;
      let targetPrice = coin.price;
      let rationale = '';

      // Lógica de Decisão Fracionada
      if (rsi <= buyRsi || coin.change24h <= dropTrigger) {
        action = 'BUY';
        actionLabel = 'HORA DE COMPRAR';
        const intensity = Math.min(1, Math.max(0.25, (buyRsi - rsi + Math.abs(coin.change24h)) / 22));
        suggestedPct = Math.round((15 + intensity * 25) / 5) * 5; // 15% a 40%
        targetPrice = coin.price * 1.075; // Alvo de repique +7.5%
        rationale = `Sobrevenda detectada (RSI ${rsi.toFixed(1)} e queda de ${coin.change24h.toFixed(2)}% em 24h). Zona estatística de desconto para acumulação gradual.`;
      } else if (rsi >= sellRsi || coin.change24h >= pumpTrigger) {
        action = 'SELL';
        actionLabel = 'VENDER PARCIAL';
        const intensity = Math.min(1, Math.max(0.2, (rsi - sellRsi + coin.change24h) / 22));
        suggestedPct = Math.round((15 + intensity * 25) / 5) * 5; // 15% a 40%
        targetPrice = coin.price * 0.935; // Alvo de recompra -6.5% mais embaixo
        rationale = `Esticamento de curto prazo (RSI ${rsi.toFixed(1)} e alta de +${coin.change24h.toFixed(2)}%). Ideal realizar lucro parcial agora para recomprar mais barato na correção.`;
      } else {
        action = 'WAIT';
        actionLabel = 'ESPERAR';
        suggestedPct = 0;
        targetPrice = coin.price * 0.955;
        rationale = `Tendência neutra/consolidação (RSI ${rsi.toFixed(1)}). Sem assimetria clara de risco-retorno no momento; aguarde recuo até $${formatPrice(coin.price * 0.955)} ou rompimento.`;
      }

      const dollarActionAmount = effectiveUsd > 0 ? (effectiveUsd * (suggestedPct / 100)) : 0;

      return {
        ...coin,
        rsi,
        rangePos,
        distFromSmaPct,
        score,
        action,
        actionLabel,
        suggestedPct,
        targetPrice,
        rationale,
        effectiveUsd,
        dollarActionAmount
      };
    }

    function processAllSignals() {
      let buyCount = 0;
      let sellCount = 0;
      let totalPortfolioUsd = 0;
      let topActionText = 'Nenhuma oportunidade extrema neste segundo';
      let highestPriorityScore = -1;

      const analyzedList = COINS_CONFIG.map(cfg => {
