        const priority = Math.abs(analysis.score) + (analysis.effectiveUsd > 0 ? 15 : 0);
        if (analysis.action !== 'WAIT' && priority > highestPriorityScore) {
          highestPriorityScore = priority;
          const moneyStr = analysis.dollarActionAmount > 0 ? ` ($${analysis.dollarActionAmount.toFixed(2)})` : '';
          topActionText = `${analysis.symbol}: ${analysis.actionLabel} ${analysis.suggestedPct}%${moneyStr}`;
