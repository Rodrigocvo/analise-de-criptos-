<!DOCTYPE html>
<html lang="pt-BR" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RG Crypto AI Copilot — Inteligência & Gestão Fracionada</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet" />
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            slate: {
              850: '#151e2e',
              925: '#0c121e',
              950: '#070b14',
            }
          }
        }
      }
    };
  </script>
  <style>
    body {
      background-color: #070b14;
      color: #f1f5f9;
    }
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0c121e;
    }
    ::-webkit-scrollbar-thumb {
      background: #1e293b;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #334155;
    }
    @keyframes pulse-glow {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.45; }
    }
    .live-dot {
      animation: pulse-glow 2s infinite;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col antialiased selection:bg-emerald-500/30 selection:text-emerald-200">

  <!-- Toast / Notificação Flutuante (Sem alert()) -->
  <div id="toastContainer" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none px-4 sm:px-0"></div>

  <!-- Barra Superior -->
  <header class="sticky top-0 z-30 bg-slate-950/90 backdrop-blur-md border-b border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-cyan-600 flex items-center justify-center shadow-lg shadow-emerald-500/20">
          <svg class="w-6 h-6 text-slate-950" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-base sm:text-lg font-extrabold tracking-tight text-white">RG Crypto AI Copilot</h1>
            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/25">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 live-dot"></span>
              <span id="connectionStatus">AO VIVO</span>
            </span>
          </div>
          <p class="text-xs text-slate-400">Monitoramento Quantitativo, Gestão Fracionada & Alertas 24/7</p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <div class="hidden md:flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-xs text-slate-300">
          <span>Próxima leitura:</span>
          <span id="countdownTimer" class="font-mono font-bold text-cyan-400">30s</span>
        </div>

        <button id="btnSoundToggle" onclick="toggleSound()" class="px-3 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 text-xs font-medium text-slate-300 flex items-center gap-1.5 transition cursor-pointer" title="Ativar/Desativar alerta sonoro">
          <span id="soundIcon">🔔</span>
          <span class="hidden sm:inline" id="soundLabel">Som: ON</span>
        </button>

        <button onclick="requestPushPermission()" class="px-3 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 text-xs font-medium text-slate-300 flex items-center gap-1.5 transition cursor-pointer" title="Permitir notificações no navegador/celular">
          <span>📲</span>
          <span class="hidden sm:inline">Notificações</span>
        </button>

        <button onclick="fetchMarketData(true)" id="btnRefresh" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-semibold text-white flex items-center gap-1.5 transition cursor-pointer">
          <svg id="refreshIcon" class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span>Atualizar</span>
        </button>

        <button onclick="switchTab('cloud')" class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-bold text-xs flex items-center gap-1.5 shadow-lg shadow-emerald-500/20 transition cursor-pointer">
          <span>☁️ Robô WhatsApp 24/7</span>
        </button>
      </div>
    </div>

    <!-- Navegação de Abas -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 flex gap-1 overflow-x-auto border-t border-slate-900/80 pt-1">
      <button onclick="switchTab('dashboard')" id="tab-dashboard" class="tab-btn px-4 py-2.5 text-xs sm:text-sm font-semibold border-b-2 border-emerald-400 text-emerald-400 whitespace-nowrap transition cursor-pointer">
        📊 Radar & Carteira Fracionada
      </button>
      <button onclick="switchTab('brain')" id="tab-brain" class="tab-btn px-4 py-2.5 text-xs sm:text-sm font-semibold border-b-2 border-transparent text-slate-400 hover:text-slate-200 whitespace-nowrap transition cursor-pointer">
        🧠 Cérebro IA & Auto-Calibragem
      </button>
      <button onclick="switchTab('alerts')" id="tab-alerts" class="tab-btn px-4 py-2.5 text-xs sm:text-sm font-semibold border-b-2 border-transparent text-slate-400 hover:text-slate-200 whitespace-nowrap transition cursor-pointer">
        ⚡ Histórico de Sinais (<span id="alertBadgeCount">0</span>)
      </button>
      <button onclick="switchTab('cloud')" id="tab-cloud" class="tab-btn px-4 py-2.5 text-xs sm:text-sm font-semibold border-b-2 border-transparent text-slate-400 hover:text-slate-200 whitespace-nowrap transition cursor-pointer">
        ☁️ Automação Nuvem + WhatsApp (Grátis)
      </button>
    </div>
  </header>

  <!-- Conteúdo Principal -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 space-y-6">

    <!-- KPIs Superiores -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 shadow-sm">
        <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
          <span>Patrimônio Total Monitorado</span>
          <span class="px-2 py-0.5 rounded-md bg-slate-800 text-slate-300 font-mono">USD</span>
        </div>
        <div id="kpiTotalPortfolio" class="text-2xl font-extrabold font-mono text-white">$0.00</div>
        <div id="kpiPortfolioSub" class="text-xs text-slate-400 mt-1">Preencha seus saldos nos cards abaixo</div>
      </div>

      <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 shadow-sm">
        <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
          <span>Termômetro do Mercado</span>
          <span id="kpiSentimentBadge" class="px-2 py-0.5 rounded-md bg-amber-500/15 text-amber-300 font-semibold">Calculando...</span>
        </div>
        <div class="flex items-baseline gap-2">
          <span id="kpiFearGreed" class="text-2xl font-extrabold font-mono text-white">--</span>
          <span class="text-xs text-slate-400">/ 100 (Índice Dinâmico)</span>
        </div>
        <div class="w-full bg-slate-800 h-1.5 rounded-full mt-2 overflow-hidden">
          <div id="kpiFearGreedBar" class="bg-gradient-to-r from-rose-500 via-amber-400 to-emerald-500 h-full rounded-full transition-all duration-500" style="width: 30%"></div>
        </div>
      </div>

      <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 shadow-sm">
        <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
          <span>Oportunidades Detectadas Agora</span>
          <span class="text-emerald-400 font-semibold">IA Ativa</span>
        </div>
        <div class="flex items-center gap-3 mt-1">
          <div>
            <span id="kpiBuyCount" class="text-xl font-extrabold font-mono text-emerald-400">0</span>
            <span class="text-xs text-slate-400 ml-1">Compras</span>
          </div>
          <span class="text-slate-700">|</span>
          <div>
            <span id="kpiSellCount" class="text-xl font-extrabold font-mono text-rose-400">0</span>
            <span class="text-xs text-slate-400 ml-1">Vendas Parciais</span>
          </div>
        </div>
        <div id="kpiTopAction" class="text-xs text-cyan-300 mt-1.5 truncate">Analisando melhores pontos...</div>
      </div>

      <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 shadow-sm">
        <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
          <span>Perfil do Motor IA</span>
          <button onclick="switchTab('brain')" class="text-cyan-400 hover:underline font-medium cursor-pointer">Calibrar</button>
        </div>
        <div class="flex items-center justify-between mt-1">
          <select id="profileSelector" onchange="changeRiskProfile(this.value)" class="bg-slate-850 border border-slate-700 text-white text-sm font-semibold rounded-xl px-3 py-1.5 w-full focus:outline-none focus:border-emerald-500">
            <option value="conservative">🛡️ Conservador (Sinais Extremos)</option>
            <option value="moderate" selected>⚖️ Moderado (Equilibrado)</option>
            <option value="aggressive">🚀 Agressivo (Giro Rápido)</option>
          </select>
        </div>
        <div id="kpiAccuracyText" class="text-xs text-slate-400 mt-1.5">Acurácia Backtest: <span class="text-emerald-400 font-mono font-bold">74.2%</span></div>
      </div>
    </section>

    <!-- ABA 1: RADAR & CARTEIRA FRACIONADA -->
    <section id="view-dashboard" class="space-y-5">
      <!-- Barra de Ferramentas Rápidas -->
      <div class="bg-slate-900/70 border border-slate-800/90 rounded-2xl p-4 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider mr-1">Filtrar Sinal:</span>
          <button onclick="setFilter('ALL')" id="filter-ALL" class="filter-chip px-3 py-1.5 rounded-xl text-xs font-semibold bg-emerald-500 text-slate-950 cursor-pointer">Todas (9)</button>
          <button onclick="setFilter('BUY')" id="filter-BUY" class="filter-chip px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700 cursor-pointer">🟢 Comprar</button>
          <button onclick="setFilter('SELL')" id="filter-SELL" class="filter-chip px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700 cursor-pointer">🔴 Vender Parcial</button>
          <button onclick="setFilter('WAIT')" id="filter-WAIT" class="filter-chip px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700 cursor-pointer">🟡 Esperar</button>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <div class="flex items-center gap-2 bg-slate-950 border border-slate-800 rounded-xl px-3 py-1.5">
            <span class="text-xs text-slate-400">WhatsApp Destino:</span>
            <input type="text" id="whatsappNumberInput" placeholder="5538999999999" oninput="saveUserSettings()" class="bg-transparent text-xs font-mono text-white w-32 focus:outline-none" />
          </div>
          <button onclick="sendSummaryToWhatsApp()" class="px-3.5 py-2 rounded-xl bg-emerald-600/20 hover:bg-emerald-600/30 border border-emerald-500/40 text-emerald-300 text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer">
            <span>💬 Enviar Resumo Geral no WhatsApp</span>
          </button>
        </div>
      </div>

      <!-- Grade das 9 Criptomoedas -->
      <div id="cryptoGrid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
        <!-- Cards renderizados dinamicamente via JS -->
      </div>
    </section>

    <!-- ABA 2: CÉREBRO IA & AUTO-CALIBRAGEM -->
    <section id="view-brain" class="hidden space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Integração Gemini API + Diagnóstico Profundo -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-base font-bold text-white flex items-center gap-2">
                <span>🧠 Copiloto Cognitivo (Gemini AI + Motor Estatístico)</span>
              </h2>
              <p class="text-xs text-slate-400 mt-0.5">Gera parecer estratégico completo sobre sua carteira e recomendações fracionadas.</p>
            </div>
          </div>

          <div class="bg-slate-950 border border-slate-800 rounded-xl p-3.5 space-y-2">
            <label class="block text-xs font-semibold text-slate-300">Chave API Google Gemini (Opcional — funciona 100% sem chave também)</label>
            <div class="flex gap-2">
              <input type="password" id="geminiApiKey" placeholder="AIzaSy... (salva apenas no seu navegador)" oninput="saveUserSettings()" class="flex-1 bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-xs font-mono text-white focus:outline-none focus:border-cyan-500" />
              <button onclick="runDeepAIAnalysis()" id="btnRunAI" class="px-4 py-2 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-bold text-xs whitespace-nowrap transition cursor-pointer">
                ✨ Analisar Carteira Agora
              </button>
            </div>
            <p class="text-[11px] text-slate-500">Se deixar vazio, nosso motor heurístico quantitativo local gera o relatório completo instantaneamente.</p>
          </div>

          <div id="aiReportOutput" class="bg-slate-950/90 border border-slate-800 rounded-xl p-4 min-h-[240px] text-sm text-slate-300 leading-relaxed space-y-3">
            <p class="text-slate-400 italic">Clique em <strong>"✨ Analisar Carteira Agora"</strong> para a IA cruzar os indicadores técnicos atuais (RSI, volatilidade, distância das médias) com os saldos que você informou e gerar um plano de ação detalhado.</p>
          </div>
        </div>

        <!-- Motor de Auto-Estudo & Backtest -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-4">
          <div>
            <h2 class="text-base font-bold text-white">📈 Auto-Estudo & Calibragem de Pesos (Backtest 30 Dias)</h2>
            <p class="text-xs text-slate-400 mt-0.5">O sistema testa diferentes limiares de RSI e variação percentual nas últimas 4 semanas para encontrar a melhor taxa de acerto.</p>
          </div>

          <div class="grid grid-cols-3 gap-3">
            <div class="bg-slate-950 border border-slate-800 rounded-xl p-3">
              <div class="text-[11px] text-slate-400">Gatilho Compra (RSI)</div>
              <div id="paramRsiBuy" class="text-lg font-mono font-bold text-emerald-400 mt-0.5">&lt; 34</div>
            </div>
            <div class="bg-slate-950 border border-slate-800 rounded-xl p-3">
              <div class="text-[11px] text-slate-400">Gatilho Venda (RSI)</div>
              <div id="paramRsiSell" class="text-lg font-mono font-bold text-rose-400 mt-0.5">&gt; 68</div>
            </div>
            <div class="bg-slate-950 border border-slate-800 rounded-xl p-3">
              <div class="text-[11px] text-slate-400">Retorno Simulado 30d</div>
              <div id="paramSimReturn" class="text-lg font-mono font-bold text-cyan-400 mt-0.5">+14.8%</div>
            </div>
          </div>

          <div class="bg-slate-950 border border-slate-800 rounded-xl p-4 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-slate-300">Simulação de Aprendizado por Reforço</span>
              <button onclick="runAutoCalibration()" id="btnCalibrate" class="px-3.5 py-1.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs transition cursor-pointer">
                🔄 Executar Auto-Calibragem
              </button>
            </div>
            <div id="calibrationLog" class="font-mono text-xs text-slate-400 space-y-1.5 max-h-48 overflow-y-auto">
              <div>[OK] Pesos atuais carregados: RSI (45%), Momentum 24h (30%), Desvio Média 7d (25%).</div>
              <div>[INFO] Pronto para recalibrar limiares conforme a volatilidade atual do mercado.</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ABA 3: HISTÓRICO DE SINAIS -->
    <section id="view-alerts" class="hidden space-y-4">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
          <div>
            <h2 class="text-base font-bold text-white">⚡ Log de Sinais & Alertas Disparados</h2>
            <p class="text-xs text-slate-400">Registro automático de todas as oportunidades detectadas durante a sessão.</p>
          </div>
          <button onclick="clearAlertHistory()" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs text-slate-300 cursor-pointer">Limpar Histórico</button>
        </div>
        <div id="alertHistoryList" class="space-y-2.5">
          <p class="text-xs text-slate-500">Nenhum alerta registrado ainda.</p>
        </div>
      </div>
    </section>

    <!-- ABA 4: AUTOMAÇÃO 24/7 NA NUVEM + WHATSAPP GRÁTIS -->
    <section id="view-cloud" class="hidden space-y-6">
      <div class="bg-gradient-to-br from-slate-900 via-slate-900 to-emerald-950/30 border border-emerald-500/30 rounded-2xl p-6 space-y-5">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-5">
          <div>
            <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">100% GRATUITO • RODA 24 HORAS NA NUVEM</span>
            <h2 class="text-xl font-extrabold text-white mt-2">Robô Autônomo 24/7 com Alertas no WhatsApp</h2>
            <p class="text-xs sm:text-sm text-slate-300 mt-1 max-w-3xl">
              Mesmo com seu celular desligado ou sem internet, este robô roda gratuitamente nos servidores do <strong>GitHub Actions</strong> a cada 15 minutos, analisa as 9 criptomoedas, calcula as porcentagens exatas da sua carteira e envia o alerta direto no seu <strong>WhatsApp</strong> via CallMeBot.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row gap-2.5 shrink-0">
            <button onclick="downloadWebAppHTML()" class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-white text-xs font-bold flex items-center justify-center gap-2 transition cursor-pointer">
              <span>⬇️ Baixar App Web (index.html)</span>
            </button>
            <button onclick="downloadPythonBot()" class="px-4 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-extrabold flex items-center justify-center gap-2 shadow-lg shadow-emerald-500/20 transition cursor-pointer">
              <span>🐍 Baixar Robô Python (.py)</span>
            </button>
          </div>
        </div>

        <!-- Passo a passo visual -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="bg-slate-950/90 border border-slate-800 rounded-xl p-4 space-y-2">
            <div class="w-7 h-7 rounded-lg bg-emerald-500/20 text-emerald-400 font-bold text-xs flex items-center justify-center">1</div>
            <h3 class="text-sm font-bold text-white">Ativar CallMeBot (Grátis)</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Salve o número <span class="text-slate-200 font-mono">+34 644 71 98 38</span> nos seus contatos e envie no WhatsApp: <code class="text-emerald-400 bg-slate-900 px-1.5 py-0.5 rounded">I allow callmebot to send me messages</code>. Você receberá sua <strong>APIKEY</strong> na hora.
            </p>
          </div>

          <div class="bg-slate-950/90 border border-slate-800 rounded-xl p-4 space-y-2">
            <div class="w-7 h-7 rounded-lg bg-cyan-500/20 text-cyan-400 font-bold text-xs flex items-center justify-center">2</div>
            <h3 class="text-sm font-bold text-white">Subir no GitHub Grátis</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Crie um repositório privado gratuito no <strong>GitHub</strong>, envie os arquivos <code class="text-cyan-300">bot_whatsapp_24h.py</code>, <code class="text-cyan-300">requirements.txt</code> e o arquivo de agendamento <code class="text-cyan-300">.github/workflows/crypto_bot.yml</code>.
            </p>
          </div>

          <div class="bg-slate-950/90 border border-slate-800 rounded-xl p-4 space-y-2">
            <div class="w-7 h-7 rounded-lg bg-purple-500/20 text-purple-400 font-bold text-xs flex items-center justify-center">3</div>
            <h3 class="text-sm font-bold text-white">Configurar Segredos e Pronto!</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Em <em>Settings &gt; Secrets &gt; Actions</em> do repositório, adicione <code class="text-purple-300">WHATSAPP_PHONE</code> e <code class="text-purple-300">CALLMEBOT_APIKEY</code>. O robô já sai configurado com os saldos que você digitou aqui!
            </p>
          </div>
        </div>

        <!-- Visualização dos arquivos gerados automaticamente com a carteira do usuário -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <div class="bg-slate-950 border border-slate-800 rounded-xl overflow-hidden">
            <div class="px-4 py-2.5 bg-slate-900 border-b border-slate-800 flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-emerald-400">bot_whatsapp_24h.py (Já inclui seus saldos!)</span>
